<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Mailbox</title>
  <style>
    body { font-family: Arial, sans-serif; background: #f8fafc; margin: 0; padding: 24px; color: #0f172a; }
    .mailbox { max-width: 780px; margin: 0 auto; background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; overflow: hidden; }
    .header { padding: 18px 20px; border-bottom: 1px solid #e2e8f0; font-weight: 700; font-size: 20px; }
    .list { list-style: none; margin: 0; padding: 0; }
    .item { padding: 16px 20px; border-bottom: 1px solid #f1f5f9; }
    .item:last-child { border-bottom: none; }
    .title { font-weight: 600; margin-bottom: 6px; }
    .message { color: #334155; margin-bottom: 6px; }
    .date { color: #64748b; font-size: 13px; }
    .empty { padding: 24px 20px; color: #64748b; }
  </style>
</head>
<body>
  <div class="mailbox">
    <div class="header"><%= userName %>'s Mailbox</div>
    <% if (notifications && notifications.length) { %>
      <ul class="list">
        <% notifications.forEach((note) => { %>
          <li class="item">
            <div class="title"><%= note.title %></div>
            <div class="message"><%= note.message %></div>
            <div class="date"><%= new Date(note.createdAt).toLocaleString() %></div>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <div class="empty">No mailbox messages yet.</div>
    <% } %>
  </div>
</body>
</html>
