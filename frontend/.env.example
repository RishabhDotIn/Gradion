# Optional: call the API directly (skips Vite proxy). Example:
# VITE_API_BASE_URL=https://your-backend.onrender.com
#
# In development, leave VITE_API_BASE_URL empty to use the Vite dev server
# and configured proxy (see `vite.config.js`). When deploying to Vercel,
# set `VITE_API_BASE_URL` to your deployed backend URL.
#
# VITE_PROXY_TARGET is only for local dev proxy configuration.
# VITE_PROXY_TARGET=http://127.0.0.1:5000
